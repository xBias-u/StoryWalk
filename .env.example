DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DATABASE_URL=
SERVE_MEDIA_FILES=True
LOG_LEVEL=INFO

# HTTPS defaults are enabled automatically when DEBUG=False. Keep the HSTS
# window short for the first deployment and raise it after verification.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ElevenLabs: keep the real values in .env, never commit them.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=StoryWalk
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
VALHALLA_API_URL=https://valhalla1.openstreetmap.de/route

# Small-scale nearby place discovery. Use a dedicated instance in production.
OVERPASS_API_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter
